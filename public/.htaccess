# SPA (React Router) sobre Apache / cPanel.
# Asume que el sitio se sube a la RAÍZ del dominio (public_html/).
# Si lo subes a un subdirectorio, cambia RewriteBase y añade `base` en vite.config.js.

# El deploy por FTP deja aquí su manifiesto de sincronización: que no sea público.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Archivos y carpetas reales se sirven tal cual.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra ruta -> index.html (deep links, refresh, /password-recovery/reset, etc.)
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Los assets llevan hash en el nombre: cache larga.
  <FilesMatch "\.(js|css|svg|png|jpe?g|gif|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # El HTML nunca se cachea (para tomar builds nuevos).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

ErrorDocument 404 /index.html
